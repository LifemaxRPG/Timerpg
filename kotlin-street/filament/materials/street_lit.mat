// Everything visible in the Filament street: walls, roofs, signs, the ground and the upright cards (props, people).
// Drawn through the classic street's own look: the vertex goes to the screen by `look` (the stage's leaned camera for
// this thing, as a clip-space matrix), while lighting and shadows use its true place in the world.
material {
    name : StreetLit,
    shadingModel : lit,
    blending : masked,
    maskThreshold : 0.5,
    vertexDomain : device,
    culling : none,
    doubleSided : false,
    parameters : [
        { type : mat4, name : look, precision : high },
        { type : sampler2d, name : albedo, precision : medium },
        { type : sampler2d, name : mask, precision : medium },
        // the picture's part this face wears (offset, size), for sprite sheets and tiled strips
        { type : float4, name : uvRect },
        // multiplies the picture (flat-coloured ground uses a white picture)
        { type : float4, name : tint },
        // the window light's colour (rgb) and how far on it is (a)
        { type : float4, name : glow },
        // what the glass mirrors at this hour (multiplies the glass, the mask's green)
        { type : float4, name : glass },
        // how much of the thing is left (a building fading out mid-turn): screen-door, whole art pixels
        { type : float, name : fade },
        // the size of an art pixel on screen, for that screen door
        { type : float, name : cell },
        // 1: a face seen only from its front (a card's two sides are two faces); 0 (unset): from both sides
        { type : float, name : oneSided },
        // the open world's see-through cone (FilamentTown/SeeThrough.kt): the eye (xyz, user world) and how far along
        // the line to the player the cut ends (w), the player's middle (xyz) and the cone's radius there (w; 0 or unset: off)
        { type : float4, name : seeA, precision : high },
        { type : float4, name : seeB, precision : high }
    ],
    requires : [ uv0, tangents ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // the true place for light and shadow; the classic look for the screen
        material.worldPosition = getWorldFromModelMatrix() * getPosition();
        // (Filament's shader world is centred on the camera; the look takes the user's world)
        material.clipSpaceTransform = materialParams.look * getUserWorldFromWorldMatrix() * getWorldFromModelMatrix();
    }
}

fragment {
    float bayer4(vec2 p) {
        vec2 q = mod(floor(p), 4.0);
        float i = q.x + 4.0 * q.y;
        // a 4x4 ordered pattern
        const float m[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);
        return (m[int(i)] + 0.5) / 16.0;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = materialParams.uvRect.xy + getUV0() * materialParams.uvRect.zw;
        vec4 c = texture(materialParams_albedo, uv) * materialParams.tint;
        // the cut-out's edge (a tree's leaves, a fence's gaps) from a sharper mip than the colour: the mipmaps average the
        // alpha, so far off a crown's leaves fell under the mask's half and the crown went while its trunk stayed
        vec2 ts = vec2(textureSize(materialParams_albedo, 0));
        vec2 ddx = dFdx(uv * ts); vec2 ddy = dFdy(uv * ts);
        float lod = 0.5 * log2(max(max(dot(ddx, ddx), dot(ddy, ddy)), 1e-8));
        c.a = textureLod(materialParams_albedo, uv, max(0.0, lod - 2.0)).a * materialParams.tint.a;
        vec4 m = texture(materialParams_mask, uv);
        if (materialParams.fade < 1.0 && bayer4(gl_FragCoord.xy / materialParams.cell) > materialParams.fade) c.a = 0.0;
        if (materialParams.oneSided > 0.5 && dot(getWorldGeometricNormalVector(), getWorldViewVector()) < 0.0) c.a = 0.0;
        // what stands in the cone from the eye to the player is cut, its edge a dither in whole art pixels; never the
        // ground (nothing under 1.5 up), never past the player
        if (materialParams.seeB.w > 0.0) {
            highp vec3 w = getUserWorldPosition();
            highp vec3 e = materialParams.seeA.xyz;
            highp vec3 ax = materialParams.seeB.xyz - e;
            highp float t = dot(w - e, ax) / max(dot(ax, ax), 1e-3);
            if (t > 0.0 && t < materialParams.seeA.w && w.y > 1.5) {
                float r = max(t * materialParams.seeB.w, 3.0);
                float k = length(w - e - ax * t) / r;
                if (k < 1.0 && bayer4(gl_FragCoord.xy / max(materialParams.cell, 1.0)) > (k - 0.7) / 0.3) c.a = 0.0;
            }
        }
        // a mask pixel at half alpha is a light in its own colour (the mask's rgb: a sign's letters, a spotlight's lens)
        float own = step(0.25, m.a) * (1.0 - step(0.75, m.a));
        float gl = m.g * (1.0 - own);
        c.rgb *= mix(vec3(1.0), materialParams.glass.rgb, gl);
        material.baseColor = c;
        // walls and paint are matt; glass (the mask's green) is smooth and reflects the sky
        material.roughness = mix(0.9, 0.2, gl);
        material.metallic = 0.0;
        material.reflectance = mix(0.2, 0.6, gl);
        // a lit room glows whole in the lamp's colour; a lit display (the mask's blue) glows in its own colours, warmed
        vec3 lamp = mix(vec3(1.0), c.rgb * 1.8, m.b);
        vec3 warm = materialParams.glow.rgb * lamp * m.r;
        material.emissive = vec4(mix(warm, m.rgb * 1.6, own) * materialParams.glow.a, 0.0);
    }
}

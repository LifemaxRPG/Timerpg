// Everything visible in the Filament street: walls, roofs, signs, the ground and the upright cards (props, people).
// Drawn through the classic street's own look: the vertex goes to the screen by `look` (the stage's leaned camera for
// this thing, as a clip-space matrix), while lighting and shadows use its true place in the world.
material {
    name : StreetLit,
    shadingModel : lit,
    blending : masked,
    maskThreshold : 0.5,
    vertexDomain : device,
    culling : none,
    doubleSided : false,
    parameters : [
        { type : mat4, name : look, precision : high },
        { type : sampler2d, name : albedo, precision : medium },
        { type : sampler2d, name : mask, precision : medium },
        // the picture's part this face wears (offset, size), for sprite sheets and tiled strips
        { type : float4, name : uvRect, precision : high },
        // a night mask kept as window pages (FilamentModels.Pages): the atlas's size (xy), the table's width in 8 x 8
        // tiles (z), the first page's tile row (w); 0 (unset): the mask is read whole
        { type : float4, name : maskMap, precision : high },
        // a batch of quantised vertices (TownVertex.quantize: 16-bit normalised): its position's origin (xyz; w: 1, on) and
        // range along each axis (posScale),
        // and its texture coordinates' map (xy + uv0 * zw, in the flipped v Filament hands the material); 0 (unset): floats
        { type : float4, name : posMap, precision : high },
        { type : float4, name : posScale, precision : high },
        { type : float4, name : uvMap, precision : high },
        // multiplies the picture (flat-coloured ground uses a white picture)
        { type : float4, name : tint },
        // the window light's colour (rgb) and how far on it is (a)
        { type : float4, name : glow },
        // what the glass mirrors at this hour (multiplies the glass, the mask's green)
        { type : float4, name : glass },
        // how much of the thing is left (a building fading out mid-turn): screen-door, whole art pixels; negative: the
        // inverse screen door (-t keeps what a fade of 1 - t drops: a far box crossing over with its building)
        { type : float, name : fade },
        // the size of an art pixel on screen, for that screen door
        { type : float, name : cell },
        // 1: a face seen only from its front (a card's two sides are two faces); 0 (unset): from both sides
        { type : float, name : oneSided },
        // the open world's see-through cone (FilamentTown/SeeThrough.kt): the eye (xyz, user world) and how far along
        // the line to the player the cut ends (w), the player's middle (xyz) and the cone's radius there (w; 0 or unset: off)
        { type : float4, name : seeA, precision : high },
        { type : float4, name : seeB, precision : high },
        // how far the cone is open (x: 0 shut, 1 open), how much of what is thinned is left (y: the ghost, a share of the
        // pixels), z: anything on at all (else the material skips it)
        { type : float4, name : seeK },
        // the tree crowns across the player's lines to the eye (centre xyz, w: radius; 0: none): each faded whole, its trunk
        // left, a screen door over the crown's whole volume with a soft rim (no hole round the player)
        { type : float4[4], name : seeCrowns, precision : high },
        // how far each crown is faded (0..1, eased on its own)
        { type : float4, name : seeCrownK },
        // a building the player is inside (the cutaway, Sims-style): what of it stands on the camera's side of the plane
        // through the player (seeCut: its normal xz towards the eye, its offset, w: 1 on) and above its ceiling
        // (seeCutY: the floor, the ceiling's underside) is cut; its floors stay
        { type : float4, name : seeCut, precision : high },
        { type : float4, name : seeCutY, precision : high }
    ],
    requires : [ uv0, tangents ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // (a quantised batch's positions back in its box: Filament's device domain applies the clip-space transform to
        // the vertex as stored, so the scale-back is a matrix in it)
        highp vec4 pm = materialParams.posMap; highp vec4 ps = materialParams.posScale;
        highp mat4 dq = pm.w != 0.0 ? mat4(vec4(ps.x, 0.0, 0.0, 0.0), vec4(0.0, ps.y, 0.0, 0.0), vec4(0.0, 0.0, ps.z, 0.0), vec4(pm.xyz, 1.0)) : mat4(1.0);
        // the true place for light and shadow; the classic look for the screen
        material.worldPosition = getWorldFromModelMatrix() * (dq * getPosition());
        // (Filament's shader world is centred on the camera; the look takes the user's world)
        material.clipSpaceTransform = materialParams.look * getUserWorldFromWorldMatrix() * getWorldFromModelMatrix() * dq;
    }
}

fragment {
    float bayer4(vec2 p) {
        vec2 q = mod(floor(p), 4.0);
        float i = q.x + 4.0 * q.y;
        // a 4x4 ordered pattern
        const float m[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);
        return (m[int(i)] + 0.5) / 16.0;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 uv0 = getUV0();
        if (materialParams.uvMap.z != 0.0) uv0 = materialParams.uvMap.xy + uv0 * materialParams.uvMap.zw;
        highp vec2 uv = materialParams.uvRect.xy + uv0 * materialParams.uvRect.zw;
        vec4 c = texture(materialParams_albedo, uv) * materialParams.tint;
        // the cut-out's edge (a tree's leaves, a fence's gaps) from a sharper mip than the colour: the mipmaps average the
        // alpha, so far off a crown's leaves fell under the mask's half and the crown went while its trunk stayed
        vec2 ts = vec2(textureSize(materialParams_albedo, 0));
        vec2 ddx = dFdx(uv * ts); vec2 ddy = dFdy(uv * ts);
        float lod = 0.5 * log2(max(max(dot(ddx, ddx), dot(ddy, ddy)), 1e-8));
        c.a = textureLod(materialParams_albedo, uv, max(0.0, lod - 2.0)).a * materialParams.tint.a;
        vec4 m;
        if (materialParams.maskMap.x > 0.0) {
            // the window pages: the atlas's texel (as a nearest sample picks it, clamped to the edge), its tile's entry in
            // the table at the texture's start, then the same texel in that page
            highp vec2 at = materialParams.maskMap.xy;
            highp ivec2 t = ivec2(clamp(floor(uv * at), vec2(0.0), at - 1.0));
            highp int e = (t.y >> 3) * int(materialParams.maskMap.z) + (t.x >> 3);
            highp int pw = textureSize(materialParams_mask, 0).x;
            highp ivec2 pg = ivec2(texelFetch(materialParams_mask, ivec2(e % pw, e / pw), 0).rg * 255.0 + 0.5);
            m = texelFetch(materialParams_mask, (pg + ivec2(0, int(materialParams.maskMap.w))) * 8 + (t & 7), 0);
        } else {
            m = texture(materialParams_mask, uv);
        }
        // (a negative fade is the same screen door turned inside out: what crosses over to it (a far box) keeps exactly
        // the pixels a positive fade of 1 + fade drops, so at every step of a crossover each pixel shows one of the two)
        if (materialParams.fade < 1.0) {
            float d = bayer4(gl_FragCoord.xy / materialParams.cell);
            if (materialParams.fade >= 0.0 ? d > materialParams.fade : d <= 1.0 + materialParams.fade) c.a = 0.0;
        }
        if (materialParams.oneSided > 0.5 && dot(getWorldGeometricNormalVector(), getWorldViewVector()) < 0.0) c.a = 0.0;
        // the see-through (SeeThrough.kt): what hides the player is thinned to a ghost, a screen door in whole art pixels;
        // never the ground (nothing under 1.5 up), never past the player. Its share kept eases smoothly to whole at the
        // edges (the cone's and each crown's): no hard ring (the owner's 100817, "the circle cut out looks bad")
        if (materialParams.seeK.z > 0.0) {
            highp vec3 w = getUserWorldPosition();
            float ghost = mix(1.0, materialParams.seeK.y, materialParams.seeK.x);
            float keep = 1.0;
            if (w.y > 1.5) {
                // the cone from the eye to the player, soft from half its radius out
                highp vec3 e = materialParams.seeA.xyz;
                highp vec3 ax = materialParams.seeB.xyz - e;
                highp float t = dot(w - e, ax) / max(dot(ax, ax), 1e-3);
                if (materialParams.seeB.w > 0.0 && t > 0.0 && t < materialParams.seeA.w) {
                    float r = max(t * materialParams.seeB.w, 3.0);
                    float k = length(w - e - ax * t) / r;
                    // (and eased in along its first stretch from the eye, so its tip is no hard point either)
                    float along = smoothstep(0.0, 0.25, t);
                    keep = min(keep, mix(1.0, ghost, (1.0 - smoothstep(0.45, 1.0, k)) * along));
                }
                // the crowns, each whole (a little past its middle's radius the screen door eases back to whole); right
                // by the eye a crown would be a screen door over the whole view: there it goes altogether
                float nearEye = smoothstep(110.0, 320.0, length(w - materialParams.seeA.xyz));
                for (int i = 0; i < 4; i++) {
                    highp vec4 cr = materialParams.seeCrowns[i];
                    if (cr.w <= 0.0) continue;
                    highp vec3 d = (w - cr.xyz) / vec3(cr.w, cr.w * 0.8, cr.w);
                    float q = length(d);
                    float g = mix(1.0, materialParams.seeK.y * nearEye, materialParams.seeCrownK[i]);
                    keep = min(keep, mix(g, 1.0, smoothstep(0.85, 1.05, q)));
                }
            }
            if (keep < 1.0 && bayer4(gl_FragCoord.xy / max(materialParams.cell, 1.0)) > keep) c.a = 0.0;
        }
        // the cutaway of a building the player is inside: its walls on the camera's side and all above its ceiling
        if (materialParams.seeCut.w > 0.0) {
            highp vec3 w = getUserWorldPosition();
            if (w.y > materialParams.seeCutY.x + 2.0) {
                highp float side = dot(w.xz, materialParams.seeCut.xy) - materialParams.seeCut.z;
                float k = max(smoothstep(0.0, 10.0, side), smoothstep(-6.0, 0.0, w.y - materialParams.seeCutY.y));
                if (k > 0.0 && bayer4(gl_FragCoord.xy / max(materialParams.cell, 1.0)) < k) c.a = 0.0;
            }
        }
        // a mask pixel at half alpha is a light in its own colour (the mask's rgb: a sign's letters, a spotlight's lens)
        float own = step(0.25, m.a) * (1.0 - step(0.75, m.a));
        float gl = m.g * (1.0 - own);
        c.rgb *= mix(vec3(1.0), materialParams.glass.rgb, gl);
        material.baseColor = c;
        // walls and paint are matt; glass (the mask's green) is smooth and reflects the sky
        material.roughness = mix(0.9, 0.2, gl);
        material.metallic = 0.0;
        material.reflectance = mix(0.2, 0.6, gl);
        // a lit room glows whole in the lamp's colour; a lit display (the mask's blue) glows in its own colours, warmed
        vec3 lamp = mix(vec3(1.0), c.rgb * 1.8, m.b);
        vec3 warm = materialParams.glow.rgb * lamp * m.r;
        material.emissive = vec4(mix(warm, m.rgb * 1.6, own) * materialParams.glow.a, 0.0);
    }
}

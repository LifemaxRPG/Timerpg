+void ggml_hexagon_session::set_power(int mode, int * n_ok, int * n_failed) noexcept(true) {
+    if (this->valid_iface) {
+        int err = htp_iface_power(this->handle, (uint32_t) mode);
+        if (err != 0) {
+            GGML_LOG_WARN("ggml-hex: %s power vote %s failed: 0x%08x\n", this->c_name(), htp_power_mode_to_str(mode), (unsigned) err);
+            ++*n_failed;
+        } else {
+            if (opt_verbose) {
+                GGML_LOG_INFO("ggml-hex: %s power mode: %s\n", this->c_name(), htp_power_mode_to_str(mode));
+            }
+            ++*n_ok;
+        }
+    }
+    for (auto & sub : this->mdev.sessions) {
+        sub->set_power(mode, n_ok, n_failed);
+    }
+}

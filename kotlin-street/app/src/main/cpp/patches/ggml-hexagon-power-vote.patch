+// Votes a power profile (a GGML_HEXAGON_POWER_MODE name, or "idle") for every live HTP session, at run time, and makes it
+// the profile sessions opened later start with. Returns the number of sessions voted, or -1 for an unknown name;
+// *n_failed (if given) counts the sessions whose vote failed (they keep the vote they had).
+static int ggml_backend_hexagon_set_power_mode(const char * name, int * n_failed) {
+    if (n_failed) *n_failed = 0;
+    const int mode = name ? htp_power_mode_from_str(name) : -1;
+    if (mode < 0) {
+        return -1;
+    }
+    static std::mutex           mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    opt_power_mode = mode;
+    ggml_backend_reg_t reg = ggml_backend_hexagon_reg();
+    auto hreg = reg ? static_cast<ggml_hexagon_registry *>(reg->context) : nullptr;
+    if (!hreg) {
+        return 0;
+    }
+    int ok = 0, failed = 0;
+    for (size_t i = 0; i < opt_ndev; i++) {
+        auto dev_ctx = static_cast<ggml_backend_hexagon_device_context *>(hreg->devices[i].context);
+        if (dev_ctx && dev_ctx->sess) {
+            dev_ctx->sess->set_power(mode, &ok, &failed);
+        }
+    }
+    if (n_failed) *n_failed = failed;
+    return ok;
+}

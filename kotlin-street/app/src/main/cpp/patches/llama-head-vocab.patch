+// timerpg: the output head's first n_vocab_head rows (all of it without timerpg.head_vocab). The loader gives a device
+// copy only those rows; a head that shares the CPU's full token_embd tensor (the same buffer) is viewed down to them.
+static ggml_tensor * timerpg_head_rows(ggml_context * ctx0, const llama_hparams & hp, ggml_tensor * w) {
+    if (hp.n_vocab_head == 0 || w->ne[1] <= (int64_t) hp.n_vocab_head) {
+        return w;
+    }
+    return ggml_view_2d(ctx0, w, w->ne[0], (int64_t) hp.n_vocab_head, w->nb[1], 0);
+}

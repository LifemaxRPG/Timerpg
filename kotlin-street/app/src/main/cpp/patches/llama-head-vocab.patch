+// timerpg: a head cut to the first K tokens (llama_hparams::n_vocab_head) gives K logits per row: each row's K go to the
+// start of its n_vocab-wide row, the rest of the row is -INFINITY (written once: nothing else writes there), so every
+// sampler still sees full rows in which the tokens past K can never win.
+static void timerpg_get_logits_async(ggml_backend_t backend, ggml_tensor * t_logits, float * out, int64_t n_rows, int64_t n_vocab) {
+    const int64_t k = t_logits->ne[0];
+    if (k >= n_vocab) {
+        ggml_backend_tensor_get_async(backend, t_logits, out, 0, n_rows*n_vocab*sizeof(float));
+        return;
+    }
+    for (int64_t r = 0; r < n_rows; ++r) {
+        float * row = out + r*n_vocab;
+        ggml_backend_tensor_get_async(backend, t_logits, row, r*t_logits->nb[1], k*sizeof(float));
+        if (!(row[k] == -INFINITY && row[n_vocab - 1] == -INFINITY && row[(k + n_vocab)/2] == -INFINITY)) {
+            std::fill(row + k, row + n_vocab, -INFINITY);
+        }
+    }
+}

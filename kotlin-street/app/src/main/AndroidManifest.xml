<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- once, to fetch the dialogue model and the voices from Hugging Face; the game itself is offline -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- whether the phone is on Wi-Fi (ConnectivityManager.getActiveNetwork needs it): the playtest recorder's uploads wait
         for Wi-Fi or the charger; without it every check threw, read as "not on Wi-Fi", and the timelines never went -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- talking to the people in the street: held while the mic button is down, heard on the phone only -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the overnight writer: a foreground service (special use: long on-device text generation) while charging, its
         progress notification, a partial wake lock while it writes, its job kept across reboots, and the owner's
         choice to let it start from the background ("Unrestricted" battery use) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- the phone's own speech recognition, when ours does not fit in memory beside the dialogue model -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:label="Timerpg Street"
        android:allowBackup="false"
        android:largeHeap="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:hardwareAccelerated="true">
        <!-- the phone's OpenCL driver, for the dialogue model on the Adreno GPU (absent: the CPU) -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- the Hexagon NPU's driver (FastRPC), for the dialogue model on the NPU (absent: the CPU or GPU) -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <!-- the overnight writer and Writer mode (night/NightWriter.kt): the dialogue model writes the bank of lines with
             the game closed, in a process of their own (":writer") with nothing of the game's in it, so the main model's
             copy on the NPU has the most room -->
        <service
            android:name="com.timerpg.street.night.NightService"
            android:process=":writer"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="While the phone is charging and the game is closed, or when the user starts Writer mode, the on-device language model writes the game characters' dialogue lines ahead of time and saves them, so the game needs little live generation. Long local computation, no data transfer or media; the user can stop it from the notification, from Writer mode's screen, or switch it off in the game." />
        </service>
        <service
            android:name="com.timerpg.street.night.NightJob"
            android:process=":writer"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- restarts the game in a fresh process (the NPU tuner: the backend reads its settings once per process) -->
        <activity
            android:name="com.timerpg.street.RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.timerpg.street.GameActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Writer mode: its own screen and launcher icon, in the writer's process (no town, renderer or voices) -->
        <activity
            android:name="com.timerpg.street.night.WriterActivity"
            android:process=":writer"
            android:label="Timerpg Writer"
            android:taskAffinity="com.timerpg.street.writer"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

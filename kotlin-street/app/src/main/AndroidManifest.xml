<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- once, to fetch the dialogue model and the voices from Hugging Face; the game itself is offline -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- talking to the people in the street: held while the mic button is down, heard on the phone only -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="Timerpg Street"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:hardwareAccelerated="true">
        <!-- the phone's OpenCL driver, for the dialogue model on the Adreno GPU (absent: the CPU) -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- the Hexagon NPU's driver (FastRPC), for the dialogue model on the NPU (absent: the CPU or GPU) -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <activity
            android:name="com.timerpg.street.GameActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
